---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import TerminalSimulator from '../components/TerminalSimulator.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="TDES - Next-Gen CSE Lab Infrastructure">
    <Navbar />

    <main class="main-content">
        <!-- Hero Section -->
        <section class="hero-section">
            <div class="hero-info">
                <div class="badge">
                    <span class="badge-dot"></span>
                    Next-Generation CSE Lab System
                </div>
                <h1 class="hero-title">
                    The Modern Lab Infrastructure for <span class="gradient-text">Computer Science</span>.
                </h1>
                <p class="hero-subtitle">
                    Empower your CS faculty and students with automated evaluations, containerized sandboxes, and encrypted submission delivery. Built to eliminate grading overhead and environment inconsistencies.
                </p>
                <div class="hero-ctas">
                    <a href="/docs/student-cli-reference" class="btn btn-primary">Try CLI Commands</a>
                    <a href="/docs/quick-start" class="btn btn-secondary">Documentation</a>
                </div>
            </div>

            <!-- Pre-rendered Terminal Console -->
            <TerminalSimulator />
        </section>

        <!-- How It Works Section (SaaS Marketing Timeline) -->
        <section id="lifecycle" class="how-it-works-section">
            <div class="section-header">
                <h2>From Curriculum to Grades: The Automated Journey</h2>
                <p>A frictionless, step-by-step cycle that bridges the gap between active student coding and reliable host evaluation.</p>
            </div>
            <div class="marketing-timeline">
                <!-- Step 1 -->
                <div class="timeline-card glass-card">
                    <div class="card-step-indicator">
                        <span class="step-label">01</span>
                        <div class="card-step-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                        </div>
                    </div>
                    <h3>Pick or Define</h3>
                    <p>Select from our standard CS curriculum libraries, author custom templates following the open standard, or request custom exercises tailored for your classroom.</p>
                </div>
                <!-- Step 2 -->
                <div class="timeline-card glass-card">
                    <div class="card-step-indicator">
                        <span class="step-label">02</span>
                        <div class="card-step-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 8 16 13"></polyline><line x1="21" y1="8" x2="9" y2="8"></line><polyline points="8 21 3 16 8 11"></polyline><line x1="3" y1="16" x2="15" y2="16"></line></svg>
                        </div>
                    </div>
                    <h3>Distribute Files</h3>
                    <p>Deliver the public package files to student machines instantly. Works over local network folders, central registries, or simple USB pen drives for air-gapped rooms.</p>
                </div>
                <!-- Step 3 -->
                <div class="timeline-card glass-card">
                    <div class="card-step-indicator">
                        <span class="step-label">03</span>
                        <div class="card-step-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        </div>
                    </div>
                    <h3>Solve & Submit</h3>
                    <p>Students write code in their favorite editor, verify logic locally with instant tests, and seal submissions in one click using secure X25519-encrypted envelopes.</p>
                </div>
                <!-- Step 4 -->
                <div class="timeline-card glass-card">
                    <div class="card-step-indicator">
                        <span class="step-label">04</span>
                        <div class="card-step-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        </div>
                    </div>
                    <h3>Sandbox Grading</h3>
                    <p>The host system extracts code, runs hidden private tests in isolated container sandboxes, calculates scores, and generates structured grading reports instantly.</p>
                </div>
            </div>
        </section>

        <!-- Digital Migration Advantages Section -->
        <section id="problem" class="digital-migration-section">
            <div class="section-header">
                <h2>Advantages of Moving from Physical Records to a Digital Lab System</h2>
                <p>Ditch the paper registers, subjective desk checks, and repetitive software setups. Upgrade to a modern digital workflow built for real Computer Science education.</p>
            </div>
            
            <div class="migration-list">
                <!-- Advantage 1 -->
                <div class="migration-item">
                    <div class="migration-number-col">
                        <div class="migration-number">01</div>
                    </div>
                    <div class="migration-content-col">
                        <h3>Standardized & 100% Objective Grading</h3>
                    </div>
                </div>

                <!-- Advantage 2 -->
                <div class="migration-item">
                    <div class="migration-number-col">
                        <div class="migration-number">02</div>
                    </div>
                    <div class="migration-content-col">
                        <h3>Error-Free Digital Record Keeping</h3>
                    </div>
                </div>

                <!-- Advantage 3 -->
                <div class="migration-item">
                    <div class="migration-number-col">
                        <div class="migration-number">03</div>
                    </div>
                    <div class="migration-content-col">
                        <h3>Avoid the Hassle of Configuring Every Machine</h3>
                    </div>
                </div>

                <!-- Advantage 4 -->
                <div class="migration-item">
                    <div class="migration-number-col">
                        <div class="migration-number">04</div>
                    </div>
                    <div class="migration-content-col">
                        <h3>Eliminating Unproductive Student Paperwork</h3>
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Choose TDES Section -->
        <section id="why-choose" class="why-choose-section">
            <div class="section-header">
                <h2>Why CS Departments Choose TDES</h2>
                <p>A lightweight, offline-first grading engine designed to seamlessly fit into your existing laboratory workflow.</p>
            </div>
            <div class="why-choose-grid">
                <!-- Card 1 -->
                <div class="why-choose-card">
                    <div class="why-choose-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                    <h3>Lightweight & Minimal Setup</h3>
                    <p>Avoid the headache of deploying heavy database servers, configuring user authentication, or maintaining complex cloud instances. TDES runs as a single, compiled tool with zero background dependencies. Just copy it over and start grading.</p>
                </div>
                <!-- Card 2 -->
                <div class="why-choose-card">
                    <div class="why-choose-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                    </div>
                    <h3>Free & Fully Open Source</h3>
                    <p>Built with absolute transparency. TDES is entirely free to use under an open-source license, meaning no vendor lock-in, zero subscription costs, and full freedom to audit and customize the code to fit your university's exact curriculum needs.</p>
                </div>
                <!-- Card 3 -->
                <div class="why-choose-card">
                    <div class="why-choose-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l22 22M16.72 11.06A10.94 10.94 0 0 1 19 12.5M5 12.5a10.94 10.94 0 0 1 5.83-2.84M8.5 16a4.89 4.89 0 0 1 7 0M12 20h.01"></path></svg>
                    </div>
                    <h3>Works 100% Offline</h3>
                    <p>Protect your exams from server crashes, slow Wi-Fi networks, and local outages. TDES executes and grades submissions completely offline, making it the perfect fit for secure, air-gapped computer labs.</p>
                </div>
                <!-- Card 4 -->
                <div class="why-choose-card">
                    <div class="why-choose-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    </div>
                    <h3>Complements Your Existing Workflow</h3>
                    <p>You don't need to rebuild your curriculum or throw away your current systems. TDES acts as a lightweight, secure helper that integrates directly into your existing command-line setups, file directories, or lab submission portals without friction.</p>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>
