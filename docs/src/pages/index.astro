---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="TDES - Next-Gen CSE Lab Infrastructure">
  <Navbar isHome={true} />

  <main class="home-container">
    <!-- Hero Section -->
    <section class="hero-full-section">
      <div class="hero-info-col">
        <div class="hero-tagline-mono" style="font-family: 'Fira Code', var(--font-mono), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">// test delivery and evaluation system</div>
        <h1 class="hero-title">
          The modern lab infrastructure for computer science.
        </h1>
        <p class="hero-subtitle">
          Empower your CS faculty and students with automated evaluations, containerized sandboxes, and encrypted submission delivery. Built to eliminate grading overhead and environment inconsistencies.
        </p>
        <div class="hero-actions">
          <a href="/docs/quick-start" class="btn-mono-filled">quick start</a>
          <a href="https://github.com/piyush-bit/Lab-Test-Evaluation-and-Delivery-System" target="_blank" rel="noopener noreferrer" class="btn-mono-outline">github ↗</a>
        </div>
      </div>
    </section>

    <!-- Timeline/Lifecycle Section -->
    <section id="lifecycle" class="timeline-section">
      <div class="timeline-header-block">
        <h2 class="timeline-section-title">From curriculum to grades</h2>
        <p class="timeline-section-subtitle">
          A frictionless, step-by-step cycle that bridges the gap between active student coding and reliable host evaluation.
        </p>
      </div>

      <div class="timeline-grid">
        <!-- Step 1 -->
        <div class="timeline-col">
          <div class="step-num-mono">01</div>
          <h3 class="step-title">Pick or define</h3>
          <p class="step-desc">
            Select from our standard CS curriculum libraries, author custom templates following the open standard, or request custom exercises tailored for your classroom.
          </p>
        </div>
        <!-- Step 2 -->
        <div class="timeline-col">
          <div class="step-num-mono">02</div>
          <h3 class="step-title">Distribute files</h3>
          <p class="step-desc">
            Deliver the public package files to student machines instantly. Works over local network folders, central registries, or simple USB pen drives for air-gapped rooms.
          </p>
        </div>
        <!-- Step 3 -->
        <div class="timeline-col">
          <div class="step-num-mono">03</div>
          <h3 class="step-title">Solve & submit</h3>
          <p class="step-desc">
            Students write code in their favorite editor, verify logic locally with instant tests, and seal submissions in one click using secure X25519-encrypted envelopes.
          </p>
        </div>
        <!-- Step 4 -->
        <div class="timeline-col">
          <div class="step-num-mono">04</div>
          <h3 class="step-title">Sandbox grading</h3>
          <p class="step-desc">
            The host system extracts code, runs hidden private tests in isolated container sandboxes, calculates scores, and generates structured grading reports instantly.
          </p>
        </div>
      </div>
    </section>

    <!-- Digital Migration Section -->
    <section id="problem" class="migration-stack-section">
      <div class="migration-header-block">
        <h2 class="migration-section-title">Advantages of moving to a digital lab system</h2>
        <p class="migration-section-subtitle">
          Ditch paper registers, subjective desk checks, and repetitive software setups.
        </p>
      </div>

      <div class="migration-stack">
        <!-- Row 1 -->
        <div class="migration-row">
          <span class="migration-num-mono">01</span>
          <span class="migration-row-title">Standardized & 100% objective grading</span>
        </div>
        <!-- Row 2 -->
        <div class="migration-row">
          <span class="migration-num-mono">02</span>
          <span class="migration-row-title">Error-free digital record keeping</span>
        </div>
        <!-- Row 3 -->
        <div class="migration-row">
          <span class="migration-num-mono">03</span>
          <span class="migration-row-title">Avoid the hassle of configuring every machine</span>
        </div>
        <!-- Row 4 -->
        <div class="migration-row">
          <span class="migration-num-mono">04</span>
          <span class="migration-row-title">Eliminating unproductive student paperwork</span>
        </div>
      </div>
    </section>

    <!-- Why Choose TDES Section -->
    <section id="why-choose" class="reasons-section">
      <div class="reasons-header-block">
        <h2 class="reasons-section-title">Why CS departments choose TDES</h2>
        <p class="reasons-section-subtitle">
          A lightweight, offline-first grading engine built to fit your existing lab workflow.
        </p>
      </div>

      <div class="reasons-grid">
        <!-- Reason 1 -->
        <div class="reasons-col">
          <div class="reason-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="reason-icon"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <h3 class="reason-title">Lightweight & minimal setup</h3>
          <p class="reason-desc">
            Runs as a single compiled tool with zero background dependencies. No databases, no auth servers to configure.
          </p>
        </div>
        <!-- Reason 2 -->
        <div class="reasons-col">
          <div class="reason-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="reason-icon"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
          </div>
          <h3 class="reason-title">Free & fully open source</h3>
          <p class="reason-desc">
            Entirely free under an open-source license — no vendor lock-in, no subscription costs, full auditability.
          </p>
        </div>
        <!-- Reason 3 -->
        <div class="reasons-col">
          <div class="reason-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="reason-icon"><line x1="1" y1="1" x2="23" y2="23"></line><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.5"></path><path d="M5 12.5a10.94 10.94 0 0 1 5.17-2.39"></path><path d="M10.71 5.05A16 16 0 0 1 22.58 9"></path><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
          </div>
          <h3 class="reason-title">Works 100% offline</h3>
          <p class="reason-desc">
            Executes and grades submissions completely offline — protects exams from server crashes and outages.
          </p>
        </div>
        <!-- Reason 4 -->
        <div class="reasons-col">
          <div class="reason-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="reason-icon"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          </div>
          <h3 class="reason-title">Complements your existing workflow</h3>
          <p class="reason-desc">
            Acts as a lightweight helper that integrates into your current command-line setups and submission portals.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer isHome={true} />
</BaseLayout>

<style>
  :global(.grid-lines-container) {
    display: none !important;
  }

  .home-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 40px 40px 40px;
    background-color: var(--bg-main);
  }

  /* Full Width Hero Layout */
  .hero-full-section {
    width: 100%;
    padding: 80px 0 100px 0;
  }

  .hero-info-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    text-align: left;
  }

  .hero-tagline-mono {
    font-family: 'Fira Code', var(--font-mono), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 16px;
    letter-spacing: 0.2px;
    text-align: left;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.8px;
    color: var(--text-primary);
    margin-bottom: 24px;
    width: 100%;
    text-align: left;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 36px;
    width: 100%;
    max-width: 800px;
    text-align: left;
    margin-left: 0;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-start;
  }

  .btn-mono-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .btn-mono-filled:hover {
    background-color: var(--btn-primary-hover);
  }

  .btn-mono-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    background-color: transparent;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-mono-outline:hover {
    border-color: var(--text-primary);
    background-color: var(--border-color);
  }

  /* Status Dashboard Column */
  .status-col {
    border-left: 1px solid var(--border-color);
    padding-left: 60px;
    display: flex;
    flex-direction: column;
    align-self: stretch;
    justify-content: flex-start;
    padding-top: 10px;
  }

  .console-box {
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 24px;
    background-color: var(--bg-terminal);
    width: 100%;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .terminal-window-header {
    display: flex;
    gap: 6px;
    margin-bottom: 20px;
  }

  .terminal-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-red { background-color: #ef4444; }
  .dot-yellow { background-color: #f59e0b; }
  .dot-green { background-color: #10b981; }

  .console-command {
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: 0.2px;
  }

  .console-section {
    margin-bottom: 12px;
  }

  .console-text-muted {
    color: #737373;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .console-text-white {
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .console-row-test {
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .console-row-metrics {
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #ffffff;
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .metrics-label {
    width: 120px;
    color: #ffffff;
  }

  .metrics-value {
    color: #ffffff;
  }

  .status-online {
    color: #10b981;
    font-weight: 700;
  }

  .console-divider {
    border-top: 1px solid var(--border-color);
    margin-top: 16px;
    margin-bottom: 16px;
    width: 100%;
  }

  .console-score-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #ffffff;
  }

  .console-score-label {
    font-weight: 700;
  }

  .console-score-value {
    font-weight: 700;
  }

  /* Section Divider line */
  .section-divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 40px 0;
    width: 100%;
  }

  /* Migration Stack Section Styles */
  .migration-stack-section {
    padding: 40px 0;
  }
  .migration-header-block {
    margin-bottom: 32px;
    text-align: left;
  }
  .migration-section-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .migration-section-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }
  .migration-stack {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-top: 1px solid var(--border-color);
  }
  .migration-row {
    display: flex;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--border-color);
  }
  .migration-num-mono {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 700;
    width: 60px;
    flex-shrink: 0;
  }
  .migration-row-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }


  /* Timeline/Steps Section */
  .timeline-section {
    padding: 40px 0;
  }

  .timeline-header-block {
    margin-bottom: 48px;
    text-align: left;
  }

  .timeline-section-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .timeline-section-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }

  .timeline-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    border-left: 1px solid var(--border-color);
    padding-left: 20px;
  }

  .step-num-mono {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 16px;
    font-weight: 700;
  }

  .step-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .step-desc {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Reasons/Why Choose Section Styles */
  .reasons-section {
    padding: 60px 0;
  }
  .reasons-header-block {
    margin-bottom: 48px;
    text-align: left;
  }
  .reasons-section-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .reasons-section-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
  }
  .reasons-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 32px;
    border-left: 1px solid var(--border-color);
  }
  .reasons-col:first-child {
    padding-left: 0;
    border-left: none;
  }
  .reasons-col:last-child {
    padding-right: 0;
  }
  .reason-icon-wrapper {
    color: var(--text-secondary);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .reason-icon {
    stroke-width: 1.5;
  }
  .reason-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .reason-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Responsive styling */
  @media (max-width: 992px) {
    .hero-full-section {
      padding: 40px 0;
    }
    .timeline-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
    .reasons-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
    .reasons-col {
      padding: 0 16px;
    }
    .reasons-col:first-child {
      padding-left: 16px;
    }
  }

  @media (max-width: 576px) {
    .home-container {
      padding: 100px 20px 20px 20px;
    }
    .hero-title {
      font-size: 2.25rem;
    }
    .timeline-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .reasons-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .reasons-col {
      padding: 0;
      border-left: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 24px;
    }
    .reasons-col:first-child {
      padding-left: 0;
    }
    .reasons-col:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
  }
</style>
