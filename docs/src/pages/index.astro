---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="TDES - Next-Gen CSE Lab Infrastructure">
  <Navbar isHome={true} />

  <main class="home-container">
    <!-- Hero Section -->
    <section class="hero-full-section">
      <div class="hero-info-col">
        <div class="hero-tagline-mono" style="font-family: 'Fira Code', var(--font-mono), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">// test delivery and evaluation system</div>
        <h1 class="hero-title">
          The modern lab infrastructure for computer science.
        </h1>
        <p class="hero-subtitle">
          tdes is a programming assignment delivery and evaluation system built to run anywhere, without internet or setup overhead, supporting any programming language.
        </p>
        <div class="hero-actions">
          <a href="/docs/quick-start" class="btn-mono-filled">quick start</a>
          <a href="https://github.com/piyush-bit/Lab-Test-Evaluation-and-Delivery-System" target="_blank" rel="noopener noreferrer" class="btn-mono-outline">github ↗</a>
        </div>
      </div>
    </section>

    <!-- Demo Showcase & Key Pillars Section (Zed Style) -->
    <section id="demo" class="zed-demo-section">
      <!-- 3-Column Pillars Grid -->
      <div class="zed-pillars-grid">
        <div class="zed-pillar-col">
          <h3 class="zed-pillar-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="zed-pillar-icon"><line x1="1" y1="1" x2="23" y2="23"></line><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.5"></path><path d="M5 12.5a10.94 10.94 0 0 1 5.17-2.39"></path><path d="M10.71 5.05A16 16 0 0 1 22.58 9"></path><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
            <span>Offline</span>
          </h3>
          <p class="zed-pillar-desc">
            Works without internet — no dependency on cloud services during exams or labs.
          </p>
        </div>
        <div class="zed-pillar-col">
          <h3 class="zed-pillar-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="zed-pillar-icon"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            <span>Portable</span>
          </h3>
          <p class="zed-pillar-desc">
            Runs on any machine, any lab, no fixed infrastructure required.
          </p>
        </div>
        <div class="zed-pillar-col">
          <h3 class="zed-pillar-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="zed-pillar-icon"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            <span>Language-agnostic</span>
          </h3>
          <p class="zed-pillar-desc">
            Not tied to one programming language — write tests for any topic.
          </p>
        </div>
      </div>

      <!-- Demo Window Frame -->
      <div class="zed-demo-frame">
        <!-- Watch Demo Floating Pill -->
        <button type="button" class="zed-watch-demo-btn" id="watchDemoBtn" aria-label="Watch Demo">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="12" viewBox="0 0 24 24" fill="currentColor" class="play-icon">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span>Watch Demo</span>
        </button>

        <div class="zed-demo-viewport">
          <!-- Light Mode Source -->
          <img
            src="/images/ui/demo-light.svg"
            alt="TDES Demo Light Mode"
            class="demo-media demo-media-light"
          />
          <!-- Dark Mode Source -->
          <img
            src="/images/ui/demo-dark.svg"
            alt="TDES Demo Dark Mode"
            class="demo-media demo-media-dark"
          />
        </div>
      </div>
    </section>

    <!-- Open Call for University Pilot Partners Section -->
    <section id="pilots" class="pilots-callout-section">
      <p class="pilots-callout-label">OPEN CALL FOR UNIVERSITY PILOT PARTNERS</p>
      <p class="pilots-callout-body">
        Modernize your computer science laboratories with zero infrastructure overhead. TDES is seeking a limited number of university CS departments for exclusive early adopter pilot programs. Partner with us to streamline student-instructor workflows and shape the future of lab management.
      </p>
      <div class="pilots-callout-actions">
        <a href="mailto:support@tdes.bypiyush.com?subject=TDES%20University%20Pilot%20Inquiry" class="btn-pilot-request">
          REQUEST PILOT INFO
        </a>
      </div>
    </section>

    <!-- Zed-Style Box Grid Feature Section -->
    <section id="grid-features" class="zed-box-grid-section">
      <div class="zed-box-grid-left-line"></div>
      <div class="zed-box-grid-right-line"></div>
      <!-- Grid Section Header -->
      <div class="zed-box-header-row">
        <div class="zed-box-header-title-block">
          <h2 class="zed-box-main-heading"><span class="serif-highlight">TDES</span> Just Works</h2>
          <p class="zed-box-main-subtext">
            Incredibly powerful out of the box. Built to run anywhere without configuration overhead, or environment hassles.
          </p>
        </div>
        <div class="zed-box-header-actions">
          <a href="https://github.com/piyush-bit/Lab-Test-Evaluation-and-Delivery-System" target="_blank" rel="noopener noreferrer" class="zed-box-action-link">View Releases &rarr;</a>
        </div>
      </div>

      <!-- Grid Row 1: 2 Columns (Large Preview Boxes) -->
      <div class="zed-box-row zed-box-row-2col">
        <!-- Box 1 -->
        <div class="zed-box-item">
          <div class="zed-box-media-viewport">
            <img src="/images/ui/student_colsole_light.png" alt="Student TDES Console Light Mode" class="zed-box-media box-media-light" />
            <img src="/images/ui/student_console_dark.png" alt="Student TDES Console Dark Mode" class="zed-box-media box-media-dark" />
          </div>
          <h3 class="zed-box-title">Student TDES Console</h3>
          <p class="zed-box-desc">
            A dedicated student workspace equipped with a built-in file browser, live test runner, and submission wizard — eliminating local toolchain setup.
          </p>
        </div>

        <!-- Box 2 -->
        <div class="zed-box-item">
          <div class="zed-box-media-viewport">
            <img src="/images/ui/admin_console_light.png" alt="Instructor & Admin Console Light Mode" class="zed-box-media box-media-light" />
            <img src="/images/ui/admin_console_dark.png" alt="Instructor & Admin Console Dark Mode" class="zed-box-media box-media-dark" />
          </div>
          <h3 class="zed-box-title">Instructor &amp; Admin Console</h3>
          <p class="zed-box-desc">
            Comprehensive lab control center to stage exercises, manage recipient keys, inspect submission envelopes, and track student status in real-time.
          </p>
        </div>
      </div>

      <!-- Grid Row 2: 3 Columns (Medium Preview Boxes) -->
      <div class="zed-box-row zed-box-row-3col">
        <!-- Box 3 -->
        <div class="zed-box-item">
          <div class="zed-box-media-viewport">
            <img src="/images/ui/monaco_light.png" alt="First-Party Monaco Editor Light Mode" class="zed-box-media box-media-light" />
            <img src="/images/ui/monaco_dark.png" alt="First-Party Monaco Editor Dark Mode" class="zed-box-media box-media-dark" />
          </div>
          <h3 class="zed-box-title">First-Party Monaco Editor</h3>
          <p class="zed-box-desc">
            Bundles Microsoft’s Monaco Editor directly inside the binary, giving students full syntax highlighting, autocompletion, and multi-file editing out of the box.
          </p>
        </div>

        <!-- Box 4 -->
        <div class="zed-box-item">
          <div class="zed-box-media-viewport">
            <img src="/images/ui/feature-verification-light.svg" alt="Instant Local Verification Light Mode" class="zed-box-media box-media-light" />
            <img src="/images/ui/feature-verification-dark.svg" alt="Instant Local Verification Dark Mode" class="zed-box-media box-media-dark" />
          </div>
          <h3 class="zed-box-title">Instant Local Verification</h3>
          <p class="zed-box-desc">
            Students run public tests locally inside isolated containers (<code class="mono-code">euc2 run</code>) for immediate pass/fail feedback before final submission.
          </p>
        </div>

        <!-- Box 5 -->
        <div class="zed-box-item">
          <div class="zed-box-media-viewport">
            <img src="/images/ui/feature-cli-light.svg" alt="Keyboard-First CLI Workflow Light Mode" class="zed-box-media box-media-light" />
            <img src="/images/ui/feature-cli-dark.svg" alt="Keyboard-First CLI Workflow Dark Mode" class="zed-box-media box-media-dark" />
          </div>
          <h3 class="zed-box-title">Keyboard-First CLI Workflow</h3>
          <p class="zed-box-desc">
            Prefer terminal tools? Complete command-line toolchain (<code class="mono-code">euc2 init</code>, <code class="mono-code">run</code>, <code class="mono-code">submit</code>) engineered for fast, scriptable terminal productivity.
          </p>
        </div>
      </div>

      <!-- Grid Row 3: 3 Columns (Text-Only Feature Grid) -->
      <div class="zed-box-row zed-box-row-3col zed-box-row-text">
        <!-- Box 6 -->
        <div class="zed-box-item zed-box-text-only">
          <h3 class="zed-box-title">Air-Gapped Operation</h3>
          <p class="zed-box-desc">
            Operate 100% offline without internet connections, cloud APIs, or external authentication servers during lab exams.
          </p>
        </div>

        <!-- Box 7 -->
        <div class="zed-box-item zed-box-text-only">
          <h3 class="zed-box-title">Zero-Dependency Executable</h3>
          <p class="zed-box-desc">
            Single compiled binary for Windows, macOS, and Linux with zero background daemons, zero databases, and zero system setup.
          </p>
        </div>

        <!-- Box 8 -->
        <div class="zed-box-item zed-box-text-only">
          <h3 class="zed-box-title">Editor-Agnostic &amp; Native Workbench</h3>
          <p class="zed-box-desc">
            Students can code in VS Code, Zed, Neovim, or standard terminal tools — or launch TDES’s embedded Monaco browser workbench.
          </p>
        </div>
      </div>
    </section>

    <!-- Quote Callout Section -->
    <section id="quote-callout" class="zed-quote-section">
      <blockquote class="zed-quote-text">
        “We shape our tools, and thereafter our tools shape us.”
      </blockquote>
      <cite class="zed-quote-author">— John Culkin</cite>
    </section>

    <!-- Growing Exercise Library Section (Infinite Marquee) -->
    <section id="library" class="zed-library-section">
      <div class="zed-library-left-line"></div>
      <div class="zed-library-right-line"></div>

      <!-- Section Header -->
      <div class="zed-box-header-row zed-library-header-row">
        <div class="zed-box-header-title-block">
          <h2 class="zed-library-heading">Growing Exercise Library</h2>
          <p class="zed-box-main-subtext">
            Pre-configured exercise suites and test templates spanning key computer science courses.
          </p>
        </div>
        <div class="zed-box-header-actions">
          <a href="https://github.com/piyush-bit/tdes-exercise-repository" target="_blank" rel="noopener noreferrer" class="zed-box-action-link">Explore Repository &rarr;</a>
        </div>
      </div>

      <!-- Infinite Marquee Row -->
      <div class="marquee-viewport">
        <div class="marquee-track">
          <!-- First Set of Course Cards -->
          <div class="marquee-card"><span class="marquee-course-name">Data Structures</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Design and Analysis of Algorithms</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Operating Systems</span></div>
          <div class="marquee-card"><span class="marquee-course-name">DBMS</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Python for Machine Learning</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Theory of Computation</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Compiler Design</span></div>

          <!-- Duplicate Set for Seamless Infinite Loop -->
          <div class="marquee-card"><span class="marquee-course-name">Data Structures</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Design and Analysis of Algorithms</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Operating Systems</span></div>
          <div class="marquee-card"><span class="marquee-course-name">DBMS</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Python for Machine Learning</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Theory of Computation</span></div>
          <div class="marquee-card"><span class="marquee-course-name">Compiler Design</span></div>
        </div>
      </div>
    </section>

    <!-- Free & Open Source Section (Minimal Centered Callout) -->
    <section id="open-source" class="zed-opensource-callout">
      <h2 class="zed-opensource-title"><span class="serif-highlight">100% Free</span> &amp; Open Source</h2>
      <p class="zed-opensource-body">
        An open-source effort to make computer science labs more efficient.
      </p>
      <div class="zed-opensource-actions">
        <a href="https://github.com/piyush-bit/Lab-Test-Evaluation-and-Delivery-System" target="_blank" rel="noopener noreferrer" class="btn-opensource-github">
          STAR ON GITHUB &rarr;
        </a>
      </div>
    </section>
  </main>

  <Footer isHome={true} />
</BaseLayout>

<style>
  :global(.grid-lines-container) {
    display: none !important;
  }

  .home-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 40px 40px 40px;
    background-color: var(--bg-main);
  }

  /* Full Width Hero Layout */
  .hero-full-section {
    width: 100%;
    padding: 80px 0 100px 0;
  }

  .hero-info-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    text-align: left;
  }

  .hero-tagline-mono {
    font-family: 'Fira Code', var(--font-mono), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 16px;
    letter-spacing: 0.2px;
    text-align: left;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.8px;
    color: var(--text-primary);
    margin-bottom: 24px;
    width: 100%;
    text-align: left;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 36px;
    width: 100%;
    max-width: 800px;
    text-align: left;
    margin-left: 0;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-start;
  }

  .btn-mono-filled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .btn-mono-filled:hover {
    background-color: var(--btn-primary-hover);
  }

  .btn-mono-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    background-color: transparent;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-mono-outline:hover {
    border-color: var(--text-primary);
    background-color: var(--border-color);
  }

  /* Status Dashboard Column */
  .status-col {
    border-left: 1px solid var(--border-color);
    padding-left: 60px;
    display: flex;
    flex-direction: column;
    align-self: stretch;
    justify-content: flex-start;
    padding-top: 10px;
  }

  .console-box {
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 24px;
    background-color: var(--bg-terminal);
    width: 100%;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .terminal-window-header {
    display: flex;
    gap: 6px;
    margin-bottom: 20px;
  }

  .terminal-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-red { background-color: #ef4444; }
  .dot-yellow { background-color: #f59e0b; }
  .dot-green { background-color: #10b981; }

  .console-command {
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: 0.2px;
  }

  .console-section {
    margin-bottom: 12px;
  }

  .console-text-muted {
    color: #737373;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .console-text-white {
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .console-row-test {
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .console-row-metrics {
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #ffffff;
    margin-bottom: 4px;
    line-height: 1.4;
  }

  .metrics-label {
    width: 120px;
    color: #ffffff;
  }

  .metrics-value {
    color: #ffffff;
  }

  .status-online {
    color: #10b981;
    font-weight: 700;
  }

  .console-divider {
    border-top: 1px solid var(--border-color);
    margin-top: 16px;
    margin-bottom: 16px;
    width: 100%;
  }

  .console-score-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #ffffff;
  }

  .console-score-label {
    font-weight: 700;
  }

  .console-score-value {
    font-weight: 700;
  }

  /* Section Divider line */
  .section-divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 40px 0;
    width: 100%;
  }

  /* Migration Stack Section Styles */
  .migration-stack-section {
    padding: 40px 0;
  }
  .migration-header-block {
    margin-bottom: 32px;
    text-align: left;
  }
  .migration-section-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .migration-section-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }
  .migration-stack {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-top: 1px solid var(--border-color);
  }
  .migration-row {
    display: flex;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--border-color);
  }
  .migration-num-mono {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 700;
    width: 60px;
    flex-shrink: 0;
  }
  .migration-row-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }


  /* Timeline/Steps Section */
  .timeline-section {
    padding: 40px 0;
  }

  .timeline-header-block {
    margin-bottom: 48px;
    text-align: left;
  }

  .timeline-section-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .timeline-section-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }

  .timeline-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    border-left: 1px solid var(--border-color);
    padding-left: 20px;
  }

  .step-num-mono {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 16px;
    font-weight: 700;
  }

  .step-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .step-desc {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Reasons/Why Choose Section Styles */
  .reasons-section {
    padding: 60px 0;
  }
  .reasons-header-block {
    margin-bottom: 48px;
    text-align: left;
  }
  .reasons-section-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .reasons-section-subtitle {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
  }
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    width: 100%;
  }
  .reasons-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0 32px;
    border-left: 1px solid var(--border-color);
  }
  .reasons-col:first-child {
    padding-left: 0;
    border-left: none;
  }
  .reasons-col:last-child {
    padding-right: 0;
  }
  .reason-icon-wrapper {
    color: var(--text-secondary);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .reason-icon {
    stroke-width: 1.5;
  }
  .reason-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .reason-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Zed-Style Demo & Pillars Section */
  .zed-demo-section {
    width: 100%;
    margin-top: 20px;
    margin-bottom: 110px;
  }

  .zed-pillars-grid {
    position: relative;
    display: grid;
