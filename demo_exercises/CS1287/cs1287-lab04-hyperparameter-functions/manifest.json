{
  "lab_id": "cs1287-lab04",
  "title": "Machine Learning Pipeline & Hyperparameter Optimizer",
  "version": "1.0.0",
  "language": "python",
  "runner_image": "lab-python-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    { "command": "make test-public",                         "points": 0, "public": true },
    { "command": "make test-submission-feature-transform",  "points": 2, "public": false },
    { "command": "make test-submission-pipeline-metrics",   "points": 3, "public": false },
    { "command": "make test-submission-model-config",        "points": 2, "public": false },
    { "command": "make test-submission-lr-scheduler",        "points": 3, "public": false }
  ],
  "submission": {
    "include_paths": [
      "pipeline_tuner.py"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.tar.gz",
      "__pycache__/*",
      "*.pyc"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 15
  }
}
