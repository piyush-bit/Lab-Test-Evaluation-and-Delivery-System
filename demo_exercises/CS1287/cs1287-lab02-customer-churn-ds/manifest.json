{
  "lab_id": "cs1287-lab02",
  "title": "Customer Churn Analytics & Feature Aggregator",
  "version": "1.0.0",
  "language": "python",
  "runner_image": "lab-python-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    { "command": "make test-public",                         "points": 0, "public": true },
    { "command": "make test-submission-extract-unique",      "points": 2, "public": false },
    { "command": "make test-submission-aggregate-metrics",   "points": 3, "public": false },
    { "command": "make test-submission-filter-churn",        "points": 3, "public": false },
    { "command": "make test-submission-merge-profiles",      "points": 2, "public": false }
  ],
  "submission": {
    "include_paths": [
      "churn_analyzer.py"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.tar.gz",
      "__pycache__/*",
      "*.pyc"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 15
  }
}
