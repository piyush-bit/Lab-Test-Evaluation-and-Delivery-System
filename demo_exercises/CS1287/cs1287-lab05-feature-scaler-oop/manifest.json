{
  "lab_id": "cs1287-lab05",
  "title": "Custom Feature Scaler & Vector Normalizer (OOP)",
  "version": "1.0.0",
  "language": "python",
  "runner_image": "lab-python-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    { "command": "make test-public",                        "points": 0, "public": true },
    { "command": "make test-submission-fit-attributes",     "points": 2, "public": false },
    { "command": "make test-submission-transform-standard", "points": 2, "public": false },
    { "command": "make test-submission-fit-transform",     "points": 2, "public": false },
    { "command": "make test-submission-inverse-transform", "points": 2, "public": false },
    { "command": "make test-submission-partial-scaling-flags", "points": 2, "public": false }
  ],
  "submission": {
    "include_paths": [
      "feature_scaler.py"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.tar.gz",
      "__pycache__/*",
      "*.pyc"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 15
  }
}
