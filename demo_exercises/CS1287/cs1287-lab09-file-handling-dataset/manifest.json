{
  "lab_id": "cs1287-lab09",
  "title": "Medical Lab Test CSV & JSON Data Processor",
  "version": "1.0.0",
  "language": "python",
  "runner_image": "lab-python-runner:v1.0",
  "local_entrypoint": "make test-public",
  "grading": [
    { "command": "make test-public",                    "points": 0, "public": true },
    { "command": "make test-submission-read-csv",        "points": 3, "public": false },
    { "command": "make test-submission-filter-abnormal", "points": 2, "public": false },
    { "command": "make test-submission-export-json",     "points": 3, "public": false },
    { "command": "make test-submission-append-log",      "points": 2, "public": false }
  ],
  "submission": {
    "include_paths": [
      "dataset_file_processor.py"
    ],
    "private_globs": [
      "reference/*",
      "tests_private/*"
    ],
    "exclude_globs": [
      "*.tar.gz",
      "__pycache__/*",
      "*.pyc"
    ]
  },
  "limits": {
    "memory_mb": 256,
    "timeout_seconds": 15
  }
}
