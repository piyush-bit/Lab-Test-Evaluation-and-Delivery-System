# ==============================================================================
# TDES Registry Server Configuration Environment File Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Network & Storage
PORT=8080
REGISTRY_DATA_ROOT=./data
REGISTRY_DB_PATH=./data/registry.db
REGISTRY_ARTIFACT_ROOT=./data/objects

# Security & Authentication Tokens
# Comma-separated instructor tokens for publishing exercises, roster onboarding, and grade exports
EUC2_INSTRUCTOR_TOKENS=instructor-secret-token-123

# Bearer token for student remote submissions
EUC2_REMOTE_BEARER_TOKEN=student-remote-token-abc

# Secret salt for student TOFU PIN hashing
EUC2_PIN_SALT=tdes-secure-salt-change-in-production

# Container Runtime (Optional override for Docker binary or host URI)
# DOCKER_BINARY=docker
